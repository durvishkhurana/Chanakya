# Required for OpenAI Decisions retrieval and final answers through OpenRouter.
# Keep real keys in the server's .env, never in frontend variables.
OPENROUTER_API_KEY=

# Optional Jev retrieval and voice interruption classification.
TYPESAFE_API_KEY=

# Optional voice features.
SARVAM_API_KEY=

# Local telephone calls through Twilio Media Streams.
# Requires streaming entitlement; current trial accounts block <Stream>.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Your own permitted mobile, in E.164 format (for example +91...).
TWILIO_ALLOWED_PHONE_NUMBER=
# HTTPS origin printed by ngrok, without a path or trailing slash.
TWILIO_PUBLIC_BASE_URL=
TWILIO_RETRIEVAL_PROVIDER=llm_batch
TWILIO_MAX_CONCURRENT_CALLS=1
TWILIO_MAX_CALL_SECONDS=600

# Jev classifies speech that overlaps Chanakya's playback.
# Enable after evaluating acknowledgment accuracy and latency for your callers.
VOICE_INTERRUPTION_ENABLED=false
VOICE_INTERRUPTION_SPECULATIVE_PAUSE=false
VOICE_INTERRUPTION_GRACE_MS=350
VOICE_INTERRUPTION_TIMEOUT_MS=4000
VOICE_INTERRUPTION_TRANSCRIPT_TIMEOUT_MS=1500

# Batch LLM retrieval uses the original multi-path voice lookup. Also supports jev, llm_batch, or legacy llm.
RETRIEVAL_MODE=llm_batch
JEV_MODEL=jev-1.13.0
RETRIEVAL_MAX_ROUNDS=12
RETRIEVAL_MAX_SECONDS=20
RETRIEVAL_REQUEST_TIMEOUT=5

# Normal LLM uses one GPT-6 Luna agent for replies and multi-path PageIndex reads.
NORMAL_LLM_REQUEST_TIMEOUT=15
NORMAL_LLM_MAX_SECONDS=45
NORMAL_LLM_EVIDENCE_BYTES=32000

# In-memory running conversation summaries and answer context budgets.
CONVERSATION_HISTORY_BUDGET_CHARS=16000
CONVERSATION_SUMMARY_MAX_CHARS=5000
CONVERSATION_RECENT_MESSAGES=12
ANSWER_CONTEXT_BUDGET_TOKENS=12000
ANSWER_RESPONSE_RESERVE_TOKENS=1500

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chanakya-sales-agent

# Chanakya feature flags (all off by default) and state.
MISSIONS_ENABLED=
PLANNER_ENABLED=
ACTIONS_ENABLED=
COACH_ENABLED=
CHANAKYA_DB_PATH=
CHANAKYA_TICK_SECONDS=

# LLM provider for chanakya/core/llm.py: openrouter or groq. Empty picks Groq only when GROQ_API_KEY is the only key.
LLM_PROVIDER=
GROQ_API_KEY=

# Prepare the next turn from partial transcripts (planner only). Extra LLM calls; keep off on rate-limited tiers.
PLANNING_WHILE_LISTENING=false
# Live calls: past this many ms the LLM reply falls back to a safe template (0 turns the bound off)
VOICE_LLM_TIMEOUT_MS=4000

# Evidence scorer for the belief tracker: lexical (default), llm (one LLM call per merchant turn) or embedding (N1).
WORRY_SCORER=lexical
# Leaf value in the look-ahead planner: formula (default, 0.8 x consent chance) or network (the N3 value network).
PLANNER_VALUE=formula
# Moves that worked in similar moments, for the look-ahead planner: forest (default, trigram clusters) or neural (N2).
PLANNER_MEMORY=forest

# Win-back missions for former merchants, and the permission-first opening for lead-list calls (both off by default).
WINBACK_ENABLED=false
PERMISSION_FIRST_ENABLED=false

# Approval queue (B10): write tools that wait for a person before they run, comma-separated (empty: none), and the wait before a request escalates.
APPROVAL_TOOLS=
APPROVAL_TIMEOUT_MINUTES=30

# Demo tools (I3): Connect phone (a Cloudflare quick tunnel to the frontend, needs cloudflared), Save run log, and a
# backend log file in .state/logs/. Off by default. PHONE_LINK_PORT is the local frontend port the tunnel exposes.
DEMO_TOOLS_ENABLED=false
PHONE_LINK_PORT=3000
# Email each onboarding link sent on a live call to one allowed inbox (yours), so it reaches a real phone. Off by
# default; demo scenarios never email. With Gmail, SMTP_PASSWORD is an app password, not the account password.
LINK_EMAIL_ENABLED=false
LINK_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
