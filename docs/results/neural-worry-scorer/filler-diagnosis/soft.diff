+def test_a_line_that_voices_no_worry_does_not_reweigh_the_worries():
+    # "Achha" scores every worry below its base rate, some less far below than others; that is noise, not evidence.
+    prior = BANK.priors[TriggerType.CALLBACK_REQUEST]
+    noise = {cid: 0.005 for cid in BANK.ids} | {"setup_hassle": 0.05}
+    tracker = BayesianBeliefTracker(BANK, scorer=CalibratedStub(noise), decay=0.0)
+    start = tracker.start(prior)
+    after = run(tracker, prior, merchant("Achha."))
+    assert all(abs(after.probabilities[c] - start.probabilities[c]) < 0.02 for c in BANK.ids)
+
