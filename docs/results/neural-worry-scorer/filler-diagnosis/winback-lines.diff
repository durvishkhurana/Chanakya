diff --git a/chanakya/neural/tests/test_paraphrase.py b/chanakya/neural/tests/test_paraphrase.py
index 6c02684..469a778 100644
--- a/chanakya/neural/tests/test_paraphrase.py
+++ b/chanakya/neural/tests/test_paraphrase.py
@@ -77,3 +77,22 @@ def test_dashes_from_a_model_become_commas():
             return '{"lines": ["Pehle batao \\u2014 koi charge?", "  "]}'
 
     assert aio.run(ask(Dashy(), "twin_a", "x", 1)) == ["Pehle batao, koi charge?"]
+
+
+def test_winback_lines_ask_why_a_former_merchant_left_and_never_copy_a_demo_line():
+    from chanakya.neural.paraphrase import WINBACK_COUNT, demo_lines, extend
+
+    class Recorder(FakeLLM):
+        async def complete(self, role, messages, **kwargs):
+            self.prompts = [*getattr(self, "prompts", []), messages[0]["content"]]
+            return await super().complete(role, messages, **kwargs)
+
+    bank, llm = default_bank(), Recorder()
+    asyncio.run(generate(llm, seed=3, bank=bank, splits={"train": ("twin_a", WINBACK_COUNT)}, winback=True))
+    assert all("past tense" in p or "no reason for leaving" in p for p in llm.prompts)
+    assert any(bank.concerns["device_issue"].description in p for p in llm.prompts)
+
+    demo = next(line for line in demo_lines() if "wapas kar diya" in line)
+    rows = extend([], [{"text": demo.rstrip("."), "split": "train"},
+                       {"text": "Machine chalti hi nahi thi theek se, toh lauta di", "split": "train"}], bank)
+    assert [r["text"] for r in rows] == ["Machine chalti hi nahi thi theek se, toh lauta di"]
